# Local dev only — on Render, set these in the dashboard's Environment tab instead.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
PASS_THRESHOLD=70

# Get this from Supabase: Project Settings -> Database -> Connection string (URI)
# Use the "Transaction pooler" connection string, port 6543, for compatibility with Render.
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Used to sign login tokens. Set this to any long random string for real use —
# generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production

# Your deployed Vercel frontend URL, once you have it, e.g.:
# FRONTEND_URL=https://level-up-interview.vercel.app
FRONTEND_URL=http://localhost:5173
